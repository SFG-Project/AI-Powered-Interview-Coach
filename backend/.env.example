# Server
PORT=5000
FRONTEND_URL=http://localhost:4200

# Firebase Admin service account fields (from Firebase console service account JSON).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_URL=

# Required for backend /api/auth/signin when using Firebase Email/Password sign-in.
FIREBASE_WEB_API_KEY=

# Optional alternative to the 3 service account fields above.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Optional xAI (Grok) integration for interview question generation and feedback.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3
